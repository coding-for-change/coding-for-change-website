# Payload CMS
PAYLOAD_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_MIN_32_CHARS
DATABASE_URL=postgresql://payload:payload@postgres:5432/payload


RESEND_API_KEY=
EMAIL_FROM=noreply@codingforchange.com
EMAIL_FROM_NAME=Coding for Change
# Fallback recipient for form submissions that don't define their own emails.
CONTACT_TO_EMAIL=info@codingforchange.com
# Absolute public origin referenced inside waitlist emails (logo image, site
# link) — mail clients can't resolve relative URLs. Empty/unset means the
# production default https://codingforchange.com; only override for testing.
PUBLIC_SITE_ORIGIN=

# Google sign-in for the CMS (/api/auth/google, inner/cms/src/endpoints/googleAuth.ts).
# An OAuth client of type "Web application" in Google Cloud, consent screen
# "Internal", with the redirect URI <PUBLIC_SITE_ORIGIN>/api/auth/google/callback
# (https://codingforchange.com/api/auth/google/callback; locally
# http://localhost/api/auth/google/callback, which needs
# PUBLIC_SITE_ORIGIN=http://localhost above). Leave any of the three empty to
# turn Google sign-in off: the endpoints then answer 503, the admin login page
# shows only the password form (which only admins may use).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only accounts of this Google Workspace domain may sign in (the ID token's `hd`).
GOOGLE_ALLOWED_DOMAIN=codingforchange.com
# Comma-separated addresses that are always admins: a new account for one of
# them is made as admin, an existing one is promoted on its next Google
# sign-in. Everyone else starts as member; the board hands out editor/admin in
# the admin panel. Empty means the default below.
ADMIN_EMAILS=info@codingforchange.com,jakob.landbrecht@codingforchange.com

# DocuSeal, self-hosted on the association's own infrastructure: the documents
# new members sign from their onboarding page (/onboarding; CMS side in
# inner/cms/src/lib/onboarding/documents.ts). Leave DOCUSEAL_URL or
# DOCUSEAL_API_KEY empty to turn it off: the page then shows no documents and
# everything else works.
# The instance's PUBLIC address, no trailing slash (e.g. https://sign.codingforchange.com).
# The CMS calls <DOCUSEAL_URL>/api and sends members to <DOCUSEAL_URL>/s/<slug>,
# so it must be reachable both from the CMS container and from members' browsers.
DOCUSEAL_URL=
# DocuSeal → Settings → API: the token for the X-Auth-Token header. Secret.
DOCUSEAL_API_KEY=
# The webhook's shared secret. In DocuSeal → Webhooks add
#   <PUBLIC_SITE_ORIGIN>/api/onboarding/docuseal-webhook
# with the form.* and submission.* events, and under its Secret the header key
#   X-Webhook-Secret
# with this value. At least 24 characters (e.g. `openssl rand -hex 32`);
# empty or shorter refuses every webhook call. Secret.
DOCUSEAL_WEBHOOK_SECRET=

# Analytics behavioural-event retention, in months. The CMS auto-purges
# analytics-events older than this (on boot + daily). Default 12. Set to 0 to
# disable the built-in purge (e.g. if you run an external cron instead).
# Note: this only affects the analytics-events table — never waitlist signups
# or form submissions, which keep their own retention.
ANALYTICS_RETENTION_MONTHS=12

# Timezone used by the /admin/analytics dashboard (day bucketing + date-range
# boundaries for /api/analytics/summary). Default Europe/Berlin.
ANALYTICS_TZ=Europe/Berlin

# ---------------------------------------------------------------------------
# Google Ads conversion tracking + GA4 (see ADS-CONVERSION-TRACKING-PLAN.md)
#
# Read at RUNTIME by the inner app's server-rendered layout, NOT baked into the
# bundle — so changing them needs only a container restart, no image rebuild.
# Leave every value empty to disable the Google tag entirely: the site then
# renders no gtag.js at all, which is what you want in dev and CI so local
# testing can't post phantom conversions to the live Ad Grants account.
#
# None of these are secrets (they ship to the browser); they differ per
# environment, which is the only reason they live here.

# Google Ads conversion ID, e.g. AW-123456789. Goals → Conversions in Google Ads.
GOOGLE_ADS_CONVERSION_ID=
# The per-action conversion labels (the short string after the "/" in the
# snippet Google shows you). One per conversion action.
GOOGLE_ADS_LABEL_WAITLIST=
GOOGLE_ADS_LABEL_APPLICATION=
# TechTour registrations (the /techtour form) — a separate conversion action.
GOOGLE_ADS_LABEL_TECHTOUR=
GOOGLE_ADS_LABEL_CONTACT=
GOOGLE_ADS_LABEL_BOOKING=
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Reporting only — do NOT also import GA4
# key events into Google Ads as conversions, or every conversion double-counts.
GA4_MEASUREMENT_ID=
